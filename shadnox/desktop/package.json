{
  "name": "shadnox",
  "version": "1.2.0",
  "description": "Shadnox: screen privacy overlay and desktop customization",
  "main": "main.js",
  "author": {
    "name": "Shadnox",
    "email": "rayyanalbasha1234@gmail.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac dmg --universal",
    "build:linux": "electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.shadnox.app",
    "productName": "Shadnox",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "overlay.html",
      "tray.png",
      "logo.png",
      "customize.js",
      "scripts/*.ps1",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shadnox-Windows-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "shortcutName": "Shadnox",
      "uninstallDisplayName": "Shadnox",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "Shadnox-Linux-${arch}.${ext}",
      "icon": "build/icon.png",
      "synopsis": "Desktop privacy overlay and customization tools",
      "maintainer": "Shadnox <rayyanalbasha1234@gmail.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "artifactName": "Shadnox-macOS-Universal.${ext}",
      "icon": "build/icon.png"
    },
    "copyright": "Copyright © 2026 Shadnox",
    "dmg": {
      "title": "Shadnox",
      "icon": "build/icon.png",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 200,
          "type": "file"
        },
        {
          "x": 480,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "https://shadnox1.onrender.com"
}
